# ============================================================================
# Crusor AI Marketing Director — environment template
# Copy to .env and fill in. NEVER commit .env.
# Every value here is a placeholder; no real credentials belong in git.
# ============================================================================

# ---- Application -----------------------------------------------------------
APP_NAME="Crusor AI Marketing Director"
ENVIRONMENT=development                 # development | staging | production | test
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Security --------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-dev-only-secret-key-not-for-production-use
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=120
# Founder account bootstrapped on first run (development only)
BOOTSTRAP_FOUNDER_EMAIL=founder@crusor.ai
BOOTSTRAP_FOUNDER_PASSWORD=change-me-dev-password

# ---- Database --------------------------------------------------------------
# Production (Supabase-compatible PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://postgres:password@db.project.supabase.co:5432/postgres
# Local dev / tests fall back to SQLite when unset:
DATABASE_URL=sqlite+aiosqlite:///./.data/crusor.db
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Alembic uses the same URL (async driver supported)
ALEMBIC_DATABASE_URL=

# ---- Redis / Celery --------------------------------------------------------
# Unset => in-process inline dispatcher and in-memory rate limiter.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
TASK_DISPATCHER=auto                    # auto | inline | celery | disabled

# ---- Object storage (S3-compatible) ---------------------------------------
# Unset => local filesystem driver under .data/storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
STORAGE_BACKEND=auto                    # auto | local | s3 | disabled

# ---- LLM gateway (provider independent) -----------------------------------
# Leave empty for offline/deterministic agents. No provider => no fabricated usage.
LLM_DEFAULT_PROVIDER=                 # openai | anthropic | openrouter
LLM_DEFAULT_MODEL=
LLM_ROUTING_JSON={}                     # e.g. {"strategy": {"provider":"anthropic","model":"claude-sonnet-4"}}
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
LLM_MONTHLY_BUDGET_USD=100
LLM_REQUEST_TIMEOUT_SECONDS=60

# ---- Agent execution limits ----------------------------------------------
AGENT_MAX_ATTEMPTS=2
AGENT_MAX_TOKENS_PER_RUN=4000
AGENT_TIMEOUT_SECONDS=120
DIRECTOR_MAX_ITERATIONS=12

# ---- Social platform apps (Phase 2 activation) ---------------------------
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Where OAuth tokens live when enabled. Tokens must never be stored in
# application tables exposed to the frontend.
TOKEN_VAULT_BACKEND=none               # none | s3 | external
