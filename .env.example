# ============================================================================
# Crusor AI Marketing Director — environment template
# Copy to .env and fill in. NEVER commit .env.
# Every value here is a placeholder; no real credentials belong in git.
# ============================================================================

# ---- Application -----------------------------------------------------------
APP_NAME="Crusor AI Marketing Director"
ENVIRONMENT=development                 # development | staging | production | test
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Security --------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-dev-only-secret-key-not-for-production-use
ACCESS_TOKEN_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=120
# Founder account bootstrapped on first run (development only)
BOOTSTRAP_FOUNDER_EMAIL=founder@crusor.ai
BOOTSTRAP_FOUNDER_PASSWORD=change-me-dev-password

# ---- Database --------------------------------------------------------------
# Production (Supabase-compatible PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://postgres:password@db.project.supabase.co:5432/postgres
# Local dev / tests fall back to SQLite when unset:
DATABASE_URL=sqlite+aiosqlite:///./.data/crusor.db
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Alembic uses the same URL (async driver supported)
ALEMBIC_DATABASE_URL=

# ---- Redis / Celery --------------------------------------------------------
# Unset => in-process inline dispatcher and in-memory rate limiter.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
TASK_DISPATCHER=auto                    # auto | inline | celery | disabled

# ---- Object storage (S3-compatible) ---------------------------------------
# Unset => local filesystem driver under .data/storage
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
STORAGE_BACKEND=auto                    # auto | local | s3 | disabled

# ---- LLM gateway (provider independent) -----------------------------------
# Leave empty for offline/deterministic agents. No provider => no fabricated usage.
LLM_DEFAULT_PROVIDER=                 # openai | anthropic | openrouter
LLM_DEFAULT_MODEL=
LLM_ROUTING_JSON={}                     # e.g. {"strategy": {"provider":"anthropic","model":"claude-sonnet-4"}}
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
LLM_MONTHLY_BUDGET_USD=100
LLM_REQUEST_TIMEOUT_SECONDS=60

# ---- Phase 2.5: provider-independent routing ------------------------------
# Each provider has its OWN credential variable. There is deliberately no
# shared LLM_KEY: one undifferentiated key is what made a cross-provider
# credential mixup possible. Never put a Velona key in OPENROUTER_API_KEY.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2

# Velona is OpenAI-compatible. The endpoint must be VERIFIED and supplied here;
# it is never guessed. With either value missing, Velona calls fail closed
# rather than borrowing another vendor's endpoint or credential.
VELONA_API_KEY=
VELONA_BASE_URL=
VELONA_TIMEOUT_SECONDS=60
VELONA_MAX_RETRIES=2

# Reject plain HTTP for remote provider endpoints. Loopback stays allowed for a
# local bridge in development; set false to forbid even that.
LLM_ALLOW_HTTP_LOCALHOST=true

# Tier routing. Point these only at a provider whose key you configured.
LLM_REASONING_PROVIDER=velona
LLM_REASONING_MODEL=deepseek-v4.1-flash
LLM_AUXILIARY_PROVIDER=velona
LLM_AUXILIARY_MODEL=qwen-3.7-flash
# Operator-verified pricing (USD/1k). Until supplied, both models are priced
# with a conservative placeholder and reported as unverified.
LLM_PRICING_JSON={}
# Phase 2.6: paid requests are blocked when a model's price is an unverified
# placeholder, because a budget reserved against an invented price is not a
# guarantee. Set this to true ONLY to accept that the placeholder may
# under-estimate by one request. Default false.
LLM_ALLOW_UNVERIFIED_PRICING=false

# ---- Agent execution limits ----------------------------------------------
AGENT_MAX_ATTEMPTS=2
AGENT_MAX_TOKENS_PER_RUN=4000
AGENT_TIMEOUT_SECONDS=120
DIRECTOR_MAX_ITERATIONS=12

# ---- Social platform apps (Phase 2 activation) ---------------------------
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# ---- Phase 4: OAuth connections and live publishing ----------------------
# Where OAuth tokens live when enabled. Tokens must never be stored in
# application tables exposed to the frontend.
#
#   none      OAuth is disabled (default). Nothing can be connected.
#   db        AES-256-GCM ciphertext in the oauth_tokens table. Requires
#             TOKEN_VAULT_KEY. social_accounts still holds only an opaque ref.
#   s3/external  Declared but not implemented: they refuse rather than silently
#             downgrading to the local backend.
TOKEN_VAULT_BACKEND=none               # none | db | s3 | external
# 32 bytes of key material: 64 hex chars, base64, or a >=32 character passphrase.
# Generate with: openssl rand -hex 32
TOKEN_VAULT_KEY=
# Public base URL of this API; the OAuth redirect URI is built from it.
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
OAUTH_STATE_TTL_SECONDS=600
# Per-platform HTTP behaviour for publish/analytics calls.
INTEGRATION_TIMEOUT_SECONDS=30
INTEGRATION_MAX_RETRIES=3
TOKEN_REFRESH_SKEW_SECONDS=120

# ---- Phase 4: paid advertising -------------------------------------------
# Every external ad mutation needs a single-use founder authorisation bound to
# the exact proposal hash. This is the hard ceiling per authorisation, in cents;
# it is a second line of defence against a mistyped budget, not a budget itself.
ADS_MAX_AUTHORIZED_SPEND_CENTS=500000

# ---- Phase 4.2: paid-media transports -------------------------------------
# Each platform has its own credential triple. There is deliberately no shared
# "ads token": a Meta token is never sent to Google or LinkedIn. Leaving a
# platform's keys empty makes that transport report `available: false` with the
# exact missing variable names — it never half-works.
#
# Credentials belong in the deployment secret store, not in this file.
#
# Meta Marketing API (Graph v21.0). The token needs ads_management on the ad
# account; META_ADS_ACCOUNT_ID is the numeric act id (the act_ prefix is added).
# META_ADS_ACCESS_TOKEN=
# META_ADS_ACCOUNT_ID=
#
# Google Ads API (REST v17). Needs an OAuth access token, a developer token
# approved for the account, and the login-customer-id that owns the billing.
# GOOGLE_ADS_ACCESS_TOKEN=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
#
# LinkedIn Marketing API (version 202405). Requires an app approved for the
# Advertising API; the account URN looks like urn:li:sponsoredAccount:123.
# LINKEDIN_ADS_ACCESS_TOKEN=
# LINKEDIN_ADS_ACCOUNT_URN=

# ---- Phase 4.2: real creative providers -----------------------------------
# One provider per medium, each with its own key. Anything other than `mock`
# bills money, so it stays refused until a verified price exists in
# CREATIVE_PRICING_JSON, CREATIVE_CAMPAIGN_BUDGET_USD is non-zero and
# CREATIVE_ALLOW_PAID_GENERATION=true.
# CREATIVE_IMAGE_PROVIDER=mock   # mock | openai | disabled
# CREATIVE_VIDEO_PROVIDER=mock   # mock | replicate | disabled
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_API_KEY=
# REPLICATE_API_TOKEN=
# Pin the exact model version you have approved; an unpinned model is refused.
# REPLICATE_VIDEO_MODEL=owner/model:version
# {"image": 0.00, "video": 0.00} — enter the contracted price, never a guess.
# CREATIVE_PRICING_JSON=
# CREATIVE_PROVIDER_CACHE_DIR=/tmp/crusor-creative
